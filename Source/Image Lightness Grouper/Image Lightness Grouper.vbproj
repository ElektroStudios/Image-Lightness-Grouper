  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!--
    SkiaSharp copies its native library (libSkiaSharp.dll) into x86, x64 and arm64 subfolders, and loads the one that
    matches the process architecture. This AnyCPU .NET Framework 4.8 application runs as x64 on 64-bit Windows and as
    x86 on 32-bit Windows (on Windows on ARM it runs as emulated x64), so the arm64 folder is never used.
  -->
  <Target Name="RemoveUnusedSkiaSharpArm64Library" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)arm64" />
  </Target>
